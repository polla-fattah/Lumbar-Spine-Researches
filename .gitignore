# ---------------------------------------------------------------------------
#  Hospital data -- NEVER COMMIT.
#  data/ contains unanonymised DICOM studies: PatientName, PatientBirthDate,
#  PatientSex and StudyDate are populated in every study sampled (12/12).
#  Committing it would write identifiable patient data permanently into git
#  history. Keep it out of the repo until it has been de-identified, and keep
#  the de-identification mapping outside the repo as well.
#
#  This one rule also covers every derived artefact below, since they all live
#  under data/. They are listed explicitly anyway, so that anyone reading this
#  file can see what exists and why none of it belongs in version control.
# ---------------------------------------------------------------------------
data/
Data/
Data_deidentified/

# Archives of the same. `data/` matches the DIRECTORY only, so a zip sitting at
# the repo root is NOT covered by it -- Data.zip (2.98 GB of Data/cases/) was
# untracked but unignored, one `git add -A` away from writing unanonymised
# patient DICOM permanently into history. Any archive is treated as suspect.
Data*.zip
*.zip

# Derived, rebuildable, and large. Regenerating all of it takes ~25 min.
#   data/cache/rsna_roi_v1.npy    4.78 GB   48,657 annotated ROI crops
#   data/cache/rsna_xseq_v1.npy   9.66 GB   98,313 geometry-derived crops
#   data/cache/series_geometry.csv          147,218 real DICOM slice headers
data/cache/

# Model weights and run outputs. Checkpoints are large and reproducible from a
# seed plus the committed code; results are regenerated by run_ladder.py.
data/checkpoints/
data/logs/
data/reports/
data/derived/

# Smoke-mode artefacts are pipeline self-tests on synthetic tensors, never
# results. Keeping them out of history removes any chance of a rehearsal being
# mistaken later for a measurement.
data/smoke/

# ---------------------------------------------------------------------------
#  Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments. implementation/venv is ~5 GB with torch + CUDA and must
# never be committed; recreate it with 01_prepare/install_pytorch_cuda.py.
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
#  LaTeX build products
#  The .tex sources and thesisstyle.sty are tracked; everything a compile
#  regenerates is not.
# ---------------------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
thesis/*.log

# ---------------------------------------------------------------------------
#  Windows / Explorer cruft
#  Google Drive writes desktop.ini into directories including .git/refs, which
#  corrupts refs and makes `git gc` fail silently. See the project memory note.
# ---------------------------------------------------------------------------
desktop.ini
Thumbs.db
$RECYCLE.BIN/

# Office lock and temp files
~$*
*.tmp

# JabRef / editor backups. JabRef has twice rewritten the .bib destructively;
# keep its backups out of the way but never rely on them.
*.bak
*.sav
*.bib.bak
*.bib.sav

# Derived caches from the 04/05/06 Track A scripts (this machine's layout).
# Same rationale as data/cache/: large, and rebuilt by the scripts that made them.
implementation/04_rsna_targets/*.csv
implementation/05_rsna_rois/*.npy
implementation/05_rsna_rois/*.csv
implementation/06_baselines/results/*.pt

# ROI ablation variant caches -- large, rebuilt by extract_rsna_rois.py
implementation/05_rsna_rois/variants/*.npy
implementation/05_rsna_rois/variants/*.log
implementation/05_rsna_rois/variants/**/*.pt
thesis/*.aux
thesis/*.bbl
thesis/*.bcf
thesis/*.blg
thesis/*.log
thesis/*.out
thesis/*.toc
thesis/*.run.xml
thesis/*.synctex.gz
