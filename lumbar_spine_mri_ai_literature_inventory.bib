@article{lee2024artificial,
  author    = {Lee, Sungwon and Jung, Joon-Yong and Mahatthanatrakul, Akaworn and Kim, Jin-Sung},
  title     = {Artificial Intelligence in Spinal Imaging and Patient Care: A Review of Recent Advances},
  year      = {2024},
  journal   = {Neurospine},
  volume    = {21},
  number    = {2},
  pages     = {474--486},
  doi       = {10.14245/ns.2448388.194},
  url       = {https://doi.org/10.14245/ns.2448388.194},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/12_2024_Lee_Artificial_Intelligence_in_Spinal_Imaging_and_Patient_Care.pdf:PDF},
  abstract  = {Narrative review organising AI in spinal imaging by clinical task rather than by architecture. Covers image-quality improvement (denoising, artifact reduction), automated quantification of anatomical and spinal-curvature measurements, vertebral segmentation and disc grading, and detection of fractures, stenosis, infection and tumours at reported expert-level performance. Extends beyond diagnosis into surgical planning via synthetic CT, augmented reality and robotic guidance, and into outcome prediction from combined imaging and clinical data. Flags interpretability, generalisability and data limitations as the main barriers, and argues multicentre collaboration on large diverse datasets is essential. Good source for wider clinical context and implementation issues.},
  comment   = {Narrative review organising AI in spinal imaging by clinical task rather than by architecture. Covers image-quality improvement (denoising, artifact reduction), automated quantification of anatomical and spinal-curvature measurements, vertebral segmentation and disc grading, and detection of fractures, stenosis, infection and tumours at reported expert-level performance. Extends beyond diagnosis into surgical planning via synthetic CT, augmented reality and robotic guidance, and into outcome prediction from combined imaging and clinical data. Flags interpretability, generalisability and data limitations as the main barriers, and argues multicentre collaboration on large diverse datasets is essential. Good source for wider clinical context and implementation issues.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: Scope and Objectives of the Review); Chapter 2 (subsection: Epidemiology and Socioeconomic Burden)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

