  author    = {Lee, Seunghun and Lee, Joon Woo and Yeom, Jin Sup and Kim, Ki-Jeong and Kim, Hyun-Jib and Chung, Soo Kyo and Kang, Heung Sik},
  title     = {A Practical {MRI} Grading System for Lumbar Foraminal Stenosis},
  year      = {2010},
  journal   = {American Journal of Roentgenology},
  volume    = {194},
  number    = {4},
  pages     = {1095--1098},
  doi       = {10.2214/ajr.09.2772},
  url       = {https://doi.org/10.2214/ajr.09.2772},
  keywords  = {Summary \& Abstract PDF},
  file      = {:papers_pdf/04_2010_Lee_A_Practical_MRI_Grading_System_for_Lumbar_Foraminal_Stenosis.pdf:PDF},
  abstract  = {[Abstract-only record - publisher full text not held.] Introduces a practical four-grade MRI system for lumbar neural foraminal stenosis on sagittal MRI: grade 0 none; grade 1 mild (perineural fat obliteration in two opposing directions); grade 2 moderate (obliteration in four directions without morphologic change); grade 3 severe (nerve-root collapse or morphologic change). Evaluated on 576 foramina in 96 patients (L3-L4 to L5-S1) by two radiologists. Inter- and intra-observer agreement was near-perfect (kappa approx. 0.80-1.0). Direct clinical precursor to the left/right foraminal narrowing targets in the RSNA challenge.},
  comment   = {[Abstract-only record - publisher full text not held.] Introduces a practical four-grade MRI system for lumbar neural foraminal stenosis on sagittal MRI: grade 0 none; grade 1 mild (perineural fat obliteration in two opposing directions); grade 2 moderate (obliteration in four directions without morphologic change); grade 3 severe (nerve-root collapse or morphologic change). Evaluated on 576 foramina in 96 patients (L3-L4 to L5-S1) by two radiologists. Inter- and intra-observer agreement was near-perfect (kappa approx. 0.80-1.0). Direct clinical precursor to the left/right foraminal narrowing targets in the RSNA challenge.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: The Three Anatomical Forms of Stenosis); Chapter 2 (subsection: Complementary Information Across Sequences and Planes); Chapter 2 (subsection: Neural Foraminal Stenosis: Lee and Sartoretti); Chapter 2 (section: Chapter Summary)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

@article{schizas2010qualitative,
  author    = {Schizas, Constantin and Theumann, Nicolas and Burn, Alexandre and Tansey, Rosamond and Wardlaw, Douglas and Smith, Francis W. and Kulik, Gerit},
  title     = {Qualitative Grading of Severity of Lumbar Spinal Stenosis Based on the Morphology of the Dural Sac on Magnetic Resonance Images},
  year      = {2010},
  journal   = {Spine},
  volume    = {35},
  number    = {21},
  pages     = {1919--1924},
  doi       = {10.1097/brs.0b013e3181d359bd},
  url       = {https://doi.org/10.1097/brs.0b013e3181d359bd},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/05_2010_Schizas_Qualitative_Grading_of_Severity_of_Lumbar_Spinal_Stenosis_Ba.pdf:PDF},
  abstract  = {Proposes the Schizas qualitative 7-grade (A-D) morphological classification of central lumbar spinal stenosis, graded from the rootlet/CSF ratio of the dural sac on axial T2 MRI rather than from cross-sectional area. Applied to 95 subjects in three groups (37 surgically treated LSS, 31 conservatively treated LSS, 27 low back pain). Intra- and inter-observer agreement were substantial and moderate respectively (kappa 0.65 and 0.44). Area measurement over-diagnosed stenosis in 35 patients and under-diagnosed in 12; grades C and D predicted failure of conservative treatment. A major clinical framework for central canal severity, and evidence that morphology beats simple area thresholds.},
  comment   = {Proposes the Schizas qualitative 7-grade (A-D) morphological classification of central lumbar spinal stenosis, graded from the rootlet/CSF ratio of the dural sac on axial T2 MRI rather than from cross-sectional area. Applied to 95 subjects in three groups (37 surgically treated LSS, 31 conservatively treated LSS, 27 low back pain). Intra- and inter-observer agreement were substantial and moderate respectively (kappa 0.65 and 0.44). Area measurement over-diagnosed stenosis in 35 patients and under-diagnosed in 12; grades C and D predicted failure of conservative treatment. A major clinical framework for central canal severity, and evidence that morphology beats simple area thresholds.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: Epidemiology and Socioeconomic Burden); Chapter 2 (subsection: The Three Anatomical Forms of Stenosis); Chapter 2 (subsection: Clinical Presentation and the Treatment Decision); Chapter 2 (subsection: Complementary Information Across Sequences and Planes); Chapter 2 (subsection: Central Canal Stenosis: Schizas and Lee); Chapter 2 (subsection: Quantitative Morphometry); Chapter 2 (section: Chapter Summary)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

@article{lee2011a,
  author    = {Lee, Guen Young and Lee, Joon Woo and Choi, Hee Seok and Oh, Kyoung-Jin and Kang, Heung Sik},
  title     = {A New Grading System of Lumbar Central Canal Stenosis on {MRI}: An Easy and Reliable Method},
  year      = {2011},
  journal   = {Skeletal Radiology},
