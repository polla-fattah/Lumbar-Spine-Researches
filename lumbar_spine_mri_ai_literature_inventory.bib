@article{huber2019qualitative,
  author    = {Huber, Florian A. and Stutz, Shanon and Vittoria de Martini, Ilaria and Mannil, Manoj and Becker, Anton S. and Winklhofer, Sebastian and Burgstaller, Jakob M. and Guggenberger, Roman},
  title     = {Qualitative versus quantitative lumbar spinal stenosis grading by machine learning supported texture analysis—Experience from the {LSOS} study cohort},
