  year     = {2021},
  note     = {Source: lumbar_spine_mri_ai.xlsx},
  keywords = {Full Paper PDF},
  url      = {https://www.jmir.org/2024/1/e54676/},
  comment  = {Feasibility study of a single comprehensive CNN (CoLumbo) reading routine clinical lumbar MRI for several degenerative findings at once. One hundred and forty-six consecutive patients with T2-weighted lumbar MRI were analysed retrospectively for vertebra and disc-segment detection and labelling plus disc herniation, disc bulging, spinal canal stenosis, nerve-root compression and spondylolisthesis, against a radiologist reference standard, using confusion matrices and McNemar's test over 888 lumbar segments. Disc detection and labelling was perfect (100\%); diagnostic accuracy was 98\% for canal stenosis, 91\% for nerve-root compression, 87\% for herniation, 87.6\% for spondylolisthesis, 86\% for extrusion and 76\% for bulging. Useful evidence on transfer beyond the development cohort, and on which findings are intrinsically harder.},
  file     = {:papers_pdf/28_2021_Lehnen_Detection_of_Degenerative_Changes_on_MR_Images_of_the_Lumbar.pdf:PDF},
}

@Article{su2022automatic,
