@article{senzgamboa2023automatic,
  author    = {Sáenz Gamboa, Jhon  Jairo and Doménech Fernández, Julio and Alonso Manjarrés, Antonio and Gómez Adrian, Jon  Ander and de la Iglesia-Vaya, Maria},
  title     = {Automatic Semantic Segmentation of the Lumbar Spine: Clinical Applicability in a Multi-Parametric and Multi-Centre Study on Magnetic Resonance Images},
  year      = {2022},
  journal   = {Artificial Intelligence in Medicine},
  doi       = {10.2139/ssrn.4272565},
  url       = {https://doi.org/10.2139/ssrn.4272565},
  keywords  = {Summary \& Abstract PDF},
  file      = {:papers_pdf/89_2023_Sáenz-Gamboa_Automatic_Semantic_Segmentation_of_the_Lumbar_Spine_Clinical.pdf:PDF},
  abstract  = {[Abstract-only record - publisher full text not held.] Multi-centre, multi-parametric study of CNN semantic segmentation of lumbar spine MRI, taking variability itself as the research problem - variability from multi-centre origins, multi-parametric acquisition protocols, human anatomy, illness severity, age and gender. Radiologists defined the pixel classes: vertebrae, intervertebral discs, nerves, blood vessels and other tissues. The topologies are U-Net variants built from complementary blocks - three convolutional block types, spatial attention models, deep supervision and a multilevel feature extractor - and several designs beat the standard U-Net baseline, especially in ensembles combining multiple networks. Direct evidence that segmentation generalisation across centres and protocols is itself a research problem.},
  comment   = {[Abstract-only record - publisher full text not held.] Multi-centre, multi-parametric study of CNN semantic segmentation of lumbar spine MRI, taking variability itself as the research problem - variability from multi-centre origins, multi-parametric acquisition protocols, human anatomy, illness severity, age and gender. Radiologists defined the pixel classes: vertebrae, intervertebral discs, nerves, blood vessels and other tissues. The topologies are U-Net variants built from complementary blocks - three convolutional block types, spatial attention models, deep supervision and a multilevel feature extractor - and several designs beat the standard U-Net baseline, especially in ensembles combining multiple networks. Direct evidence that segmentation generalisation across centres and protocols is itself a research problem.},
