@article{ishimoto2020could,
  author    = {Ishimoto, Yuyu and Jamaludin, Amir and Cooper, Cyrus and Walker-Bone, Karen and Yamada, Hiroshi and Hashizume, Hiroshi and Oka, Hiroyuki and Tanaka, Sakae and Yoshimura, Noriko and Yoshida, Munehito and Urban, Jill and Kadir, Timor and Fairbank, Jeremy},
  title     = {Could automated machine-learned {MRI} grading aid epidemiological studies of lumbar spinal stenosis? Validation within the Wakayama spine study},
  year      = {2020},
  journal   = {BMC Musculoskeletal Disorders},
  volume    = {21},
  number    = {1},
  doi       = {10.1186/s12891-020-3164-1},
  url       = {https://doi.org/10.1186/s12891-020-3164-1},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/26_2020_Ishimoto_Could_Automated_Machine-Learned_MRI_Grading_Aid_Epidemiologi.pdf:PDF},
  abstract  = {Background: MRI scanning has revolutionized the clinical diagnosis of lumbar spinal stenosis (LSS). However, there is currently no consensus as to how best to classify MRI findings which has hampered the development of robust longitudinal epidemiological studies of the condition. We developed and tested an automated system for grading lumbar spine MRI scans for central LSS for use in epidemiological research.},
  comment   = {Validation of automated SpineNet-style grading of central lumbar spinal stenosis inside a population-based epidemiological cohort, the Wakayama Spine Study, where all scans were graded by a spinal surgeon. Complete axial views were available for 4855 lumbar levels from 971 participants; 4365 views trained the system and the remaining 490 were graded blind, in four classes (none, mild, moderate, severe). Exact-grade agreement was 65.7\% with Lin's concordance 0.73, a two-grade discrepancy in only 2.2\% and three-grade in 0.2\%. Collapsed to severe versus no/mild/moderate, agreement rose to 94.1\% with kappa 0.75. Evidence that automated grading can carry large-scale epidemiological studies, and a clear illustration of how much ordinal boundary error dominates the error budget.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: The Ordinal Structure of the Label Space); Chapter 2 (subsection: The Clinical Asymmetry of Error); Chapter 2 (subsection: Population and Epidemiological Cohorts); Chapter 2 (subsection: Metrics and Their Appropriateness); Chapter 2 (subsection: What the Literature Has Established)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

@article{won2020spinal,
  author    = {Won, Dongkyu and Lee, Hyun-Joo and Lee, Suk-Joong and Park, Sang Hyun},
  title     = {Spinal Stenosis Grading in Magnetic Resonance Imaging Using Deep Convolutional Neural Networks},
  year      = {2020},
  journal   = {Spine},
  volume    = {45},
  number    = {12},
  pages     = {804--812},
  doi       = {10.1097/brs.0000000000003377},
  url       = {https://doi.org/10.1097/brs.0000000000003377},
  keywords  = {Summary \& Abstract PDF},
  file      = {:papers_pdf/27_2020_Won_Spinal_Stenosis_Grading_in_Magnetic_Resonance_Imaging_Using_.pdf:PDF},
  abstract  = {[Abstract-only record - publisher full text not held.] Retrospective study testing whether deep CNNs can grade spinal stenosis as consistently as experts. For 542 L4-5 axial MR images, two experts independently localised the canal centre and graded status; two CNN classifiers, each trained on one expert's labels, were validated by 10-fold cross-validation. Each classifier pairs a Faster R-CNN detection stage that localises patches near the canal with a VGG classification stage. Agreement between the two experts was 77.5\% accuracy / 75\% F1; each expert versus their own trained model was 83\%/75.4\% and 77.9\%/74.9\%. Critically, the expert-expert difference was significant while each expert-model difference was not - the models sit inside the band of human disagreement. A direct deep-CNN stenosis-grading comparator.},
  comment   = {[Abstract-only record - publisher full text not held.] Retrospective study testing whether deep CNNs can grade spinal stenosis as consistently as experts. For 542 L4-5 axial MR images, two experts independently localised the canal centre and graded status; two CNN classifiers, each trained on one expert's labels, were validated by 10-fold cross-validation. Each classifier pairs a Faster R-CNN detection stage that localises patches near the canal with a VGG classification stage. Agreement between the two experts was 77.5\% accuracy / 75\% F1; each expert versus their own trained model was 83\%/75.4\% and 77.9\%/74.9\%. Critically, the expert-expert difference was significant while each expert-model difference was not - the models sit inside the band of human disagreement. A direct deep-CNN stenosis-grading comparator.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: Label Noise as a Performance Ceiling); Chapter 2 (subsection: From Binary Detection to Multi-Level, Multi-Pathology Grading); Chapter 2 (subsection: Private and Single-Institution Cohorts); Chapter 2 (subsection: Benchmarking Against Clinicians); Chapter 2 (subsection: What the Literature Has Established)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

@article{lehnen2021detection,
  author    = {Lehnen, Nils Christian and Haase, Robert and Faber, Jennifer and Rüber, Theodor and Vatter, Hartmut and Radbruch, Alexander and Schmeel, Frederic Carsten},
  title     = {Detection of Degenerative Changes on {MR} Images of the Lumbar Spine with a Convolutional Neural Network: A Feasibility Study},
  year      = {2021},
  journal   = {Diagnostics},
  volume    = {11},
  number    = {5},
  pages     = {902},
  doi       = {10.3390/diagnostics11050902},
  url       = {https://doi.org/10.3390/diagnostics11050902},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/28_2021_Lehnen_Detection_of_Degenerative_Changes_on_MR_Images_of_the_Lumbar.pdf:PDF},
  abstract  = {Our objective was to evaluate the diagnostic performance of a convolutional neural network (CNN) trained on multiple MR imaging features of the lumbar spine, to detect a variety of different degenerative changes of the lumbar spine. One hundred and forty-six consecutive patients underwent routine clinical MRI of the lumbar spine including T2-weighted imaging and were retrospectively analyzed using a CNN for detection and labeling of vertebrae, disc segments, as well as presence of disc herniation, disc bulging, spinal canal stenosis, nerve root compression, and spondylolisthesis. The assessment of a radiologist served as the diagnostic reference standard. We assessed the CNN's diagnostic accuracy and consistency using confusion matrices and McNemar's test. In our data, 77 disc herniations (thereof 46 further classiﬁed as extrusions), 133 disc bulgings, 35 spinal canal stenoses, 59 nerve root compressions, and 20 segments with spondylolisthesis were present in a total of 888 lumbar spine segments. The CNN yielded a perfect accuracy score for intervertebral disc detection and labeling (100%), and moderate to high diagnostic accuracy for the detection of disc herniations (87%; 95% CI: 0.84, 0.89), extrusions (86%; 95% CI: 0.84, 0.89), bulgings (76%; 95% CI: 0.73, 0.78), spinal canal stenoses (98%; 95% CI: 0.97, 0.99), nerve root compressions (91%; 95% CI: 0.89, 0.92), and spondylolisthesis (87.61%; 95% CI: 85.26, 89.21), respectively. Our data suggest that automatic diagnosis of multiple different degenerative changes of the lumbar spine is feasible using a single comprehensive CNN. The CNN provides high diagnostic accuracy for intervertebral disc labeling and detection of clinically relevant degenerative changes such as spinal canal stenosis and disc extrusion of the lumbar spine.},
  comment   = {Feasibility study of a single comprehensive CNN (CoLumbo) reading routine clinical lumbar MRI for several degenerative findings at once. One hundred and forty-six consecutive patients with T2-weighted lumbar MRI were analysed retrospectively for vertebra and disc-segment detection and labelling plus disc herniation, disc bulging, spinal canal stenosis, nerve-root compression and spondylolisthesis, against a radiologist reference standard, using confusion matrices and McNemar's test over 888 lumbar segments. Disc detection and labelling was perfect (100\%); diagnostic accuracy was 98\% for canal stenosis, 91\% for nerve-root compression, 87\% for herniation, 87.6\% for spondylolisthesis, 86\% for extrusion and 76\% for bulging. Useful evidence on transfer beyond the development cohort, and on which findings are intrinsically harder.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: From Binary Detection to Multi-Level, Multi-Pathology Grading); Chapter 2 (subsection: Private and Single-Institution Cohorts); Chapter 2 (subsection: Gap 1: The Spine Is Modelled as Independent Predictions)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

@article{su2022automatic,
  author    = {Su, Zhi-Hai and Liu, Jin and Yang, Min-Sheng and Chen, Zi-Yang and You, Ke and Shen, Jun and Huang, Cheng-Jie and Zhao, Qing-Hao and Liu, En-Qing and Zhao, Lei and Feng, Qian-Jin and Pang, Shu-Mao and Li, Shao-Lin and Lu, Hai},
  title     = {Automatic Grading of Disc Herniation, Central Canal Stenosis and Nerve Roots Compression in Lumbar Magnetic Resonance Image Diagnosis},
  year      = {2022},
  journal   = {Frontiers in Endocrinology},
  volume    = {13},
  doi       = {10.3389/fendo.2022.890371},
  url       = {https://doi.org/10.3389/fendo.2022.890371},
  keywords  = {Summary \& Abstract PDF},
  file      = {:papers_pdf/29_2022_Su_Automatic_Grading_of_Disc_Herniation_Central_Canal_Stenosis_.pdf:PDF},
  abstract  = {REPORT] Inventory Record #29 Automatic Grading of Disc Herniation, Central Canal Stenosis and Nerve Roots Compression in Lumbar Magnetic Resonance Image Diagnosis Authors: Zhi-Hai Su, Jin Liu, Min-Sheng Yang, Zi-Yang Chen, Ke You, Jun Shen, Cheng-Jie Huang, Qing-Hao Zhao, En-Qing Liu, Lei Zhao, Qian-Jin Feng, Shu-Mao Pang, Shao-Lin Li, Hai Lu Publication / Venue: Frontiers in Endocrinology Year: 2022 DOI: 10.3389/fendo.2022.890371 Primary Source URL: https://doi.org/10.3389/fendo.2022.890371 Inventory Category: DL stenosis / multi-pathology Comparability / Priority: Very High | Priority: Critical Study Details & Methodology from Literature Inventory Study Type / MRI View: Multi-pathology grading | Lumbar MRI Dataset & Cohort: None (Sample: Development + external cohort reported) Disease / Target: Disc herniation, central stenosis, nerve-root compression Model / AI Method: ResNet-50-based deep learning Evaluation Metrics: None Key Finding / Relevance: None Thesis Context (Ch 2): Conceptually close to RSNA because it grades several lumbar degenerative findings rather than one binary diagnosis. Abstract / Summary Aim Accurate severity grading of lumbar spine disease by magnetic resonance images (MRIs) plays an important role in selecting appropriate treatment for the disease. However, interpreting these complex MRIs is a repetitive and time-consuming workload for clinicians, especially radiologists. Here, we aim to develop a multi-task classification model based on artificial intelligence for automated grading of lumbar disc herniation (LDH), lumbar central canal stenosis (LCCS) and lumbar nerve roots compression (LNRC) at lumbar axial MRIs.},
  comment   = {[Abstract-only record - publisher full text not held.] Multi-task ResNet-50 model grading three conditions jointly from lumbar axial T2 MRI: disc herniation (LDH), central canal stenosis (LCCS) and nerve-root compression (LNRC), using one shared backbone and three fully connected heads. Internal set of 15,254 axial T2 images (Fifth Affiliated Hospital, Sun Yat-sen, 2015-2019) split 70/15/15, plus an independent external test set of 1,273 images from a different hospital; two clinicians annotated with international classification systems and an expert surgeon adjudicated disagreements. Accuracies were 84.17\%/86.99\%/81.21\% internally and 74.16\%/79.65\%/74.16\% externally, with substantial to almost perfect agreement (Gwet kappa 0.67-0.85). Conceptually the closest pre-RSNA analogue: several lumbar findings graded together, with an honest external-validation drop of roughly 7-10 points.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: Label Noise as a Performance Ceiling); Chapter 2 (subsection: From Binary Detection to Multi-Level, Multi-Pathology Grading); Chapter 2 (subsection: Chronological Synthesis); Chapter 2 (subsection: Convolutional Networks); Chapter 2 (subsection: Relational and Graph-Based Modelling); Chapter 2 (subsection: Private and Single-Institution Cohorts); Chapter 2 (subsection: Metrics and Their Appropriateness); Chapter 2 (subsection: External Validation and Domain Shift); Chapter 2 (subsection: Gap 1: The Spine Is Modelled as Independent Predictions)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

@article{lim2022improved,
  author    = {Lim, Desmond Shi Wei and Makmur, Andrew and Zhu, Lei and Zhang, Wenqiao and Cheng, Amanda J. L. and Sia, David Soon Yiew and Eide, Sterling Ellis and Ong, Han Yang and Jagmohan, Pooja and Tan, Wei Chuan and Khoo, Vanessa Meihui and Wong, Ying Mei and Thian, Yee Liang and Baskar, Sangeetha and Teo, Ee Chin and Algazwi, Diyaa Abdul Rauf and Yap, Qai Ven and Chan, Yiong Huak and Tan, Jiong Hao and Kumar, Naresh and Ooi, Beng Chin and Yoshioka, Hiroshi and Quek, Swee Tian and Hallinan, James Thomas Patrick Decourcy},
  title     = {Improved Productivity Using Deep Learning–assisted Reporting                     for Lumbar Spine {MRI}},
  year      = {2022},
  journal   = {Radiology},
  volume    = {305},
  number    = {1},
  pages     = {160--166},
  doi       = {10.1148/radiol.220076},
  url       = {https://doi.org/10.1148/radiol.220076},
  keywords  = {Summary \& Abstract PDF},
  file      = {:papers_pdf/30_2022_Lim_Improved_Productivity_Using_Deep_Learning-Assisted_Reporting.pdf:PDF},
  abstract  = {REPORT] Inventory Record #34 Improved Productivity Using Deep Learning-Assisted Reporting for Lumbar Spine MRI Authors: Desmond Shi Wei Lim, Andrew Makmur, Lei Zhu, Wenqiao Zhang, Amanda J. L. Cheng, Soon Yiew Sia, Sterling Ellis Eide, Han Yang Ong, Pooja Jagmohan, Wei Chuan Tan, Vanessa Meihui Khoo, Ying Mei Wong, Yee Liang Thian, Sangeetha Baskar, Ee Chin Teo, Diyaa Abdul Rauf Algazwi, Qai Ven Yap, Yiong Huak Chan, Jiong Hao Tan, Naresh Kumar, Beng Chin Ooi, Hiroshi Yoshioka, Swee Tian Quek, James Thomas Patrick Decourcy Hallinan Publication / Venue: Radiology Year: 2022 DOI: 10.1148/radiol.305.1.2.podcast Primary Source URL: https://pubs.rsna.org/doi/abs/10.1148/radiol.220076 Inventory Category: DL stenosis / multi-pathology Comparability / Priority: High | Priority: Critical Study Details & Methodology from Literature Inventory Study Type / MRI View: Reader-assistance / workflow study | Lumbar MRI Dataset & Cohort: nan (Sample: nan) Disease / Target: Lumbar spinal stenosis reporting Model / AI Method: DL decision support Evaluation Metrics: Reporting time, interobserver agreement, diagnostic performance Key Finding / Relevance: DL assistance reduced reporting time and maintained or improved agreement. Thesis Context (Ch 2): Connects technical performance with actual clinical workflow value. Abstract / Summary},
  comment   = {[Abstract-only record - publisher full text not held.] Reader study measuring what deep-learning assistance actually buys in the reporting workflow. Eight radiologists with 2-13 years of spine MRI experience read the same studies with and without a DL model for spinal canal, lateral recess and neural foraminal stenosis, separated by a one-month washout, against an external musculoskeletal radiologist with 32 years' experience as reference; 444 images from 25 patients. Interpretation time per study fell from 124-274 s to 47-71 s (p < .001), and interobserver agreement was superior or equivalent for every stenosis grading. The largest gain was for general and in-training radiologists on four-class foraminal stenosis, where kappa rose from 0.39 to 0.71 and 0.70. Connects technical performance to real clinical workflow value.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: Chronological Synthesis); Chapter 2 (subsection: Metrics and Their Appropriateness); Chapter 2 (subsection: Reader-Assistance Studies and Workflow Impact); Chapter 2 (subsection: Scope and Delimitations)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

