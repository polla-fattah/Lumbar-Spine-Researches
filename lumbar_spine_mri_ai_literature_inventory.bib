@article{tumko2024a,
  author    = {Tumko, Vladislav and Kim, Jack and Uspenskaia, Natalia and Honig, Shaun and Abel, Frederik and Lebl, Darren R. and Hotalen, Irene and Kolisnyk, Serhii and Kochnev, Mikhail and Rusakov, Andrej and Mourad, Raphaël},
  title     = {A neural network model for detection and classification of lumbar spinal stenosis on {MRI}},
  year      = {2024},
  journal   = {European Spine Journal},
  volume    = {33},
  number    = {3},
  pages     = {941--948},
  doi       = {10.1007/s00586-023-08089-2},
  url       = {https://doi.org/10.1007/s00586-023-08089-2},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/36_2024_Tumko_A_Neural_Network_Model_for_Detection_and_Classification_of_L.pdf:PDF},
  abstract  = {Objectives To develop a three-stage convolutional neural network (CNN) approach to segment anatomical structures, clas- sify the presence of lumbar spinal stenosis (LSS) for all 3 stenosis types: central, lateral recess and foraminal and assess its severity on spine MRI and to demonstrate its efficacy as an accurate and consistent diagnostic tool.},
  comment   = {Three-stage CNN that segments anatomical structures, then detects and grades all three stenosis types - central, lateral recess and foraminal - on T2 sagittal and axial MRI at each vertebral level. Trained on 1,635 annotated lumbar studies and evaluated on a genuinely independent external set of 150 studies graded absent/mild/moderate/severe by a panel of 7 radiologists, with majority voting and external adjudication as reference. The model matched or beat the radiologist average on every type: central canal sensitivity/specificity/AUROC 0.971/0.864/0.963 versus radiologists' 0.786/0.899/0.842; lateral recess 0.853/0.787/0.907 versus 0.713/0.898/0.805; foraminal 0.942/0.844/0.950 versus 0.879/0.877/0.878. Multi-class severity showed comparable margins. One of the closest pre-RSNA clinical studies, and unusual in pairing a large training set with a properly panel-graded external test.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: Why MRI is the Reference Modality); Chapter 2 (subsection: Label Noise as a Performance Ceiling); Chapter 2 (subsection: External Validation and Domain Shift); Chapter 2 (subsection: Benchmarking Against Clinicians); Chapter 2 (subsection: What the Literature Has Established)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

@article{wang2025a,
  author    = {Wang, Tianyi and Wang, Aobo and Zhang, Yiling and Liu, Xingyu and Fan, Ning and Yuan, Shuo and Du, Peng and Wu, Qichao and Chen, Ruiyuan and Xi, Yu and Gu, Zhao and Fei, Qi and Zang, Lei},
  title     = {A novel deep learning system for automated diagnosis and grading of lumbar spinal stenosis based on spine {MRI}: model development and validation},
