@inproceedings{houlsby2019parameterefficient,
  author    = {Houlsby, Neil and Giurgiu, Andrei and Jastrz{\k{e}}bski, Stanis{\l}aw and Morrone, Bruna and de Laroussilhe, Quentin and Gesmundo, Andrea and Attariyan, Mona and Gelly, Sylvain},
  title     = {Parameter-Efficient Transfer Learning for NLP},
  year      = {2019},
  booktitle = {Proceedings of the 36th International Conference on Machine Learning (ICML)},
  pages     = {2790--2799},
  url       = {https://arxiv.org/abs/1902.00751},
  eprint    = {1902.00751},
  eprinttype = {arXiv},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/134_2019_Houlsby_Parameter-Efficient_Transfer_Learning_for_NLP.pdf:PDF},
  abstract  = {Fine-tuning large pre-trained models is an effec- tive transfer mechanism in NLP. However, in the presence of many downstream tasks, ﬁne-tuning is parameter inefﬁcient: an entire new model is required for every task. As an alternative, we propose transfer with adapter modules. Adapter modules yield a compact and extensible model; they add only a few trainable parameters per task, and new tasks can be added without revisiting previous ones. The parameters of the original network remain ﬁxed, yielding a high degree of parameter sharing. To demonstrate adapter's ef- fectiveness, we transfer the recently proposed BERT Transformer model to 26 diverse text clas- siﬁcation tasks, including the GLUE benchmark. Adapters attain near state-of-the-art performance, whilst adding only a few parameters per task. On GLUE, we attain within 0.4% of the performance of full ﬁne-tuning, adding only3.6% parameters per task. By contrast, ﬁne-tuning trains100% of the parameters per task.1},
  comment   = {Introduces adapter modules, small bottleneck layers inserted into a frozen pretrained network so that only a few parameters are trained per task. The mechanism proposed in Chapter 3 for adapting an RSNA-pretrained model to the Rizgary cohort without overfitting the small local sample.},
  note      = {Thesis Citation: [Chapter 3: Chapter 3 (subsection: Adaptation Strategies)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

