  comment  = {Validation of automated SpineNet-style grading of central lumbar spinal stenosis inside a population-based epidemiological cohort, the Wakayama Spine Study, where all scans were graded by a spinal surgeon. Complete axial views were available for 4855 lumbar levels from 971 participants; 4365 views trained the system and the remaining 490 were graded blind, in four classes (none, mild, moderate, severe). Exact-grade agreement was 65.7\% with Lin's concordance 0.73, a two-grade discrepancy in only 2.2\% and three-grade in 0.2\%. Collapsed to severe versus no/mild/moderate, agreement rose to 94.1\% with kappa 0.75. Evidence that automated grading can carry large-scale epidemiological studies, and a clear illustration of how much ordinal boundary error dominates the error budget.},
  file     = {:papers_pdf/26_2020_Ishimoto_Could_Automated_Machine-Learned_MRI_Grading_Aid_Epidemiologi.pdf:PDF},
}

@Article{won2020spinal,
