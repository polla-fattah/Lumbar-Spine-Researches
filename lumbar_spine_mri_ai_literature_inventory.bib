@misc{rsna2024rsna,
  author    = {{Radiological Society of North America}},
  title     = {{RSNA} 2024 Lumbar Spine Degenerative Classification AI Challenge},
  year      = {2024},
  howpublished = {Radiological Society of North America},
  url       = {https://www.rsna.org/artificial-intelligence/ai-image-challenge/lumbar-spine-degenerative-classification-ai-challenge},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/69_2024_RSNA_RSNA_2024_Lumbar_Spine_Degenerative_Classification_AI_Challe.pdf:PDF},
  comment   = {[Challenge documentation record - this PDF is the RSNA acknowledgments document listing the organising team, contributing institutions, curators and the ASNR annotator panel, not a research paper. See record 70 for the peer-reviewed dataset description.] The RSNA 2024 Lumbar Spine Degenerative Classification AI Challenge is the origin of the thesis dataset and label structure. It asks for 25 severity grades per study - five conditions (spinal canal stenosis, left and right neural foraminal narrowing, left and right subarticular stenosis) at each of five disc levels (L1/L2 through L5/S1) - each graded Normal/Mild, Moderate or Severe, across three sequences (sagittal T1, sagittal T2/STIR, axial T2), with expert coordinate annotations available for the labelled anatomy. Critically, the task is condition x side x level grading, not generic image-level three-class classification.},
  note      = {},
}

@article{richards2026the,
  author    = {Richards, Tyler J. and Flanders, Adam E. and Colak, Errol and Prevedello, Luciano M. and Ball, Robyn L. and Kitamura, Felipe and Mongan, John and Vazirabad, Maryam and Lin, Hui-Ming and Kendell, Anne and Kanthawang, Thanat and Angkurawaranon, Salita and Altinmakas, Emre and Dogan, Hakan and Kuriki, Paulo Eduardo de Aguiar and Somasundaram, Arjuna and Rushton, Christopher and Bulja, Deniz and Spahović, Naida and Sommer, Jennifer and Jiang, Sirui and Farina, Eduardo Moreno Júdice de Mattos and Caminha Nunes, Eduardo and Brassil, Michael and McNamara, Megan and Ortiz, Johanna and Peoples, Jacob and Uytana, Vinson L. and Kam, Anthony and Dola, Venkata N. S. and Murphy, Daniel and Vu, David and Hakim, Arsany and Talbott, Jason F. and for the Dataset Contributor Group and for the Dataset Annotator Group and for the Competition Data Notebook and Curation Group and Yost, Samantha and Berg, Nedim Kruscica and Hadzalic, Damir and Chowdhury, Rahin and Waters, Conor and Harris, Johnathon and Rizwan, Arsalan P. and Yue, Jianwei and Hakim, Arsany and Chan, Lai Peng and Uytana, Vinson Louis and Kam, Anthony and Dola, Venkata Naga Srinivas and Bathla, Girish and Ting, Yonghan and Murphy, Daniel and Vu, David and Choudhary, Gagandeep and Lim, Tze Chwan and Farage, Luciano and Lincoln, Christie and Chew, Kian Ming and Bailey, Katie and de Oliveira, Eduardo Portela and Moron, Fanny and Singh, Achint Kumar and Sollmann, Nico and Seifert, Kim and Schwartz, Eric D. and Montaño, Mariana Sanchez and Chung, Charlotte Yuk-Yan and Shah, Lubdha and Chan, Ling Ling and Andersen, Scott R. and Hutchins, Troy and Nassanga, Rita and Masum, Rukya Ali and Soderlund, Karl and Chong, Le Roy and Clemente, Jonathan D. and Hussain, Ali Haikal and Low, Keynes and Hadi, Mohiuddin and Hollander, Michael and Rahim, Nurul Hafidzah Binti and Capera, Angela Guarnizo and Mitchell, Lex A. and D’Anna, Gennaro and Hoeffner, Ellen and Go, John L. and Diaz, Facundo Nahuel and Ormsby, Jacob and Nath, Jaya and von Fischer, Nathaniel and Zohrabian, Vahe M. and Muthukumarasamy, Mary Niroshinee and Vlok, Sucari and Paruk, Nafisa and Anwar, Shayan Sirat Maheen and Cruciata, Giuseppe and Islam, Omar and Siakallis, Loizos and Ikuta, Ichiro and Suri, Abhinav and Wentland, Andrew and Trivedi, Hari and Sho, Jason},
  title     = {The {RSNA} Lumbar Degenerative Imaging Spine Classification                     ({LumbarDISC}) Dataset},
  year      = {2026},
  journal   = {Radiology: Artificial Intelligence},
  volume    = {8},
  number    = {2},
  doi       = {10.1148/ryai.250480},
  url       = {https://doi.org/10.1148/ryai.250480},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/70_2026_Richards_The_RSNA_Lumbar_Degenerative_Imaging_Spine_Classification_Lu.pdf:PDF},
  comment   = {The authoritative peer-reviewed description of LumbarDISC, the dataset behind the RSNA 2024 challenge and the thesis: MRI studies from 2,697 patients, 8,593 series, 8 institutions across 6 countries and 5 continents, built to be the largest and most diverse expertly annotated lumbar spondylosis dataset. Inclusion required sagittal T2-like (spin echo T2, STIR or Dixon), sagittal T1 and axial T2 series covering at least 3 disc levels, patients 18+, imaged as outpatients for degenerative disease; hardware, non-degenerative pathology, severe scoliosis and heavy artifact were excluded. The label distributions are the crucial detail for anyone training on it, and they are severely imbalanced: of 13,474 spinal canal grades, 85.4\% normal/mild, 8.8\% moderate, 5.9\% severe; of 26,919 neural foraminal grades, approx. 78\% normal/mild, approx. 18\% moderate, approx. 4.5\% severe; of 26,285 subarticular grades, approx. 69\% normal/mild, approx. 19\% moderate, approx. 11\% severe. The paper also documents the annotation and curation workflow and the training/public/private test partitions, and notes that published radiologist inter-rater agreement on these grades ranges from poor to substantial depending on location - which bounds what any model trained on these labels can achieve.},
  note      = {},
}

@article{batra2025mscan,
  author    = {Arnesh Batra and Arush Gumber and Anushk Kumar},
  title     = {M-SCAN: A Multistage Framework for Lumbar Spinal Canal Stenosis Grading Using Multi-View Cross Attention},
  year      = {2025},
  journal   = {arXiv preprint},
  url       = {https://arxiv.org/abs/2503.01634},
  eprint    = {2503.01634},
  eprinttype = {arxiv},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/71_2025_Batra_M-SCAN_A_Multistage_Framework_for_Lumbar_Spinal_Canal_Stenos.pdf:PDF},
  comment   = {M-SCAN: a multistage framework for grading spinal canal stenosis on the RSNA 2024 dataset (1,975 unique studies, five disc levels, Normal/Mild - Moderate - Severe), explicitly designed to fuse sagittal and axial views rather than pool slices generically. Stage one trains a U-Net to identify stenosis points on sagittal images; later stages use a multi-view, sequence-based 2.5D architecture with cross-attention to optimise feature extraction and cross-view alignment. A deliberate design choice is robustness to real-world messiness: unlike prior work assuming uniform histograms and a fixed slice count per study, M-SCAN handles a variable number of axial and sagittal slices and processes the whole spine at once for a holistic per-level prediction. Reports AUROC 0.971, state-of-the-art on this dataset; code is public. The most direct methodological comparator on the thesis's own data.},
  note      = {},
}

@techreport{park2025multiview,
  author    = {Park, R. Y. and Windsor, R. and Jamaludin, A. and Zisserman, A.},
  title     = {Multi-View and Multimodal Radiological Grading Using Spinal MRIs},
