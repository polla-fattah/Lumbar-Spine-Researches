@article{trinc2026beyond,
  author    = {Tr{\^i}nc, Emanuel-Cr{\u{a}}ciun and Ancu{\c{t}}i, Cosmin and Ancu{\c{t}}i, Codru{\c{t}}a and Iacob, Emil-Radu},
  title     = {Beyond Accuracy: Multi-Level Ordinal Assessment of Lumbar Spine Degeneration from Multiplanar {MRI} Using the {RSNA} 2024 ({LumbarDISC}) Dataset and Condition-Specific {ViTs}},
  year      = {2026},
  journal   = {Preprints.org},
  doi       = {10.20944/preprints202608.1250.v1},
  url       = {https://doi.org/10.20944/preprints202608.1250.v1},
  keywords  = {Full Paper PDF},
  file      = {:papers_pdf/110_2026_Trinc_Beyond_Accuracy_Multi-Level_Ordinal_Assessment_of_Lumbar_Spine.pdf:PDF},
  abstract  = {Lumbar spine degeneration assessment from magnetic resonance imaging (MRI) involves multiple anatomical conditions, spinal levels, and ordered severity categories, making conventional accuracy alone insufficient for a complete evaluation. In this study, we present a Beyond-Accuracy framework for automated lumbar spine degeneration assessment using the RSNA 2024 Lumbar Spine Degen- erative Classification dataset. Five independent Vision Transformer (ViT) pipelines were developed for spinal canal stenosis (SCS), left and right neural foraminal narrowing (LFN/RFN), and left and right subarticular stenosis (LSS/RSS). Localized MRI crops centered on annotated spinal-level co- ordinates were used to classify severity as Normal/Mild, Moderate, or Severe. For each condition, 24 ViT architecture and hyperparameter configurations were explored across ViT-B/16, ViT-L/16, ViT-B/32, and ViT-L/32 backbones, followed by repeated-run stability analysis. The selected condition- specific models achieved approximately 82-92% validation accuracy, with SCS reaching the highest performance at approximately 92%. Conventional measures, including accuracy, precision, recall, and F1-score, were complemented by Ordinal Accuracy (OA), Condition-Level Ordinal Accuracy (CLOA), and three Patient-Level Ordinal Accuracy (PLOA) formulations to characterize severity ordering at global, condition, and patient levels. The results show that exact classification accuracy alone does not fully capture model behavior in structured severity prediction. Combining condition-specific ViT pipelines with multi-level ordinal-aware evaluation provides a more comprehensive framework for lumbar degeneration assessment and supports the development of more interpretable MRI-based decision-support systems.},
  comment   = {Presents a multi-level ordinal evaluation framework on RSNA 2024 LumbarDISC using condition-specific Vision Transformers (ViTs), evaluating discrimination, distance-aware ordinal penalties, patient burden, and anatomical correctness.},
  note      = {Thesis Citation: [Chapter 2: Chapter 2 (subsection: Ordinal-Aware Objectives and Whether They Help); Chapter 2 (subsection: Gap 5: Ordinal Structure and Clinical Cost Remain Partially Unexploited)]. Thesis Importance: Provides critical context, methodology, baseline comparison, or clinical validation standard for Selar's PhD dissertation.},
}

